{
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "types": [
      "bun",
      "vite/client",
      "unplugin-icons/types/solid",
      "chrome-types"
    ]
  },
  "include": [
    "src/**/*.d.ts",
    "src/**/__tests__/**/*.ts",
    "src/**/__tests__/**/*.tsx",
    "test/**/*.ts"
  ],
  "exclude": ["dist", "node_modules"]
}
