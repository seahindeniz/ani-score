{
  "name": "ani-score",
  "displayName": "AniScore",
  "type": "module",
  "version": "0.4.0",
  "private": true,
  "description": "Instantly see anime ratings from AniList on your favorite streaming sites",
  "author": {
    "name": "seahindeniz",
    "url": "https://github.com/seahindeniz"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/seahindeniz/ani-score.git"
  },
  "engines": {
    "bun": ">=1.4"
  },
  "scripts": {
    "dev": "bun run clear && NODE_ENV=development bun run --parallel \"dev:*\"",
    "dev-firefox": "bun run clear && NODE_ENV=development EXTENSION=firefox bun run --parallel dev:prepare dev:background dev:web-build dev:js",
    "dev:prepare": "bun scripts/prepare.ts --mode development",
    "dev:background": "bun run build:background --mode development",
    "dev:web": "vite --mode development",
    "dev:web-build": "vite build --mode development --watch",
    "dev:js": "bun run build:js --mode development",
    "build": "NODE_ENV=production bun run --sequential clear build:web build:prepare build:background build:js",
    "build-firefox": "EXTENSION=firefox bun run build",
    "build:prepare": "bun scripts/prepare.ts",
    "build:background": "vite build --config vite.config.background.ts",
    "build:web": "vite build",
    "build:js": "bun vite.config.content.ts",
    "pack": "NODE_ENV=production bun scripts/pack.ts",
    "pack:zip": "bun run pack --zip",
    "pack:crx": "bun run pack --crx",
    "pack:xpi": "bun run pack --xpi",
    "start:chromium": "web-ext run --source-dir ./extension --target=chromium",
    "start:firefox": "web-ext run --source-dir ./extension --target=firefox-desktop",
    "clear": "bun scripts/clear.ts",
    "lint": "bun check -b",
    "test": "bun test --conditions development --conditions browser --coverage && bun scripts/check-coverage.ts",
    "test:e2e": "playwright test",
    "codegen": "graphql-codegen",
    "release": "release-it",
    "test:watch": "bun test --conditions development --conditions browser --watch"
  },
  "dependencies": {
    "@floating-ui/dom": "1.7.4",
    "@kobalte/core": "^0.13.11",
    "@nozbe/microfuzz": "1.0.0",
    "@solid-primitives/event-listener": "2.4.3",
    "@solid-primitives/scheduled": "1.5.2",
    "@solidjs/router": "0.15.3",
    "@urql/core": "6.0.1",
    "minisearch": "7.2.0",
    "solid-js": "^1.9.9"
  },
  "devDependencies": {
    "@babel/core": "7.29.0",
    "@babel/preset-typescript": "7.29.7",
    "@ffflorian/jszip-cli": "^3.8.5",
    "@graphql-codegen/cli": "6.0.0",
    "@graphql-codegen/client-preset": "5.0.2",
    "@happy-dom/global-registrator": "21.0.3",
    "@iconify-json/streamline-freehand": "1.2.1",
    "@iconify-json/streamline-freehand-color": "1.2.2",
    "@iconify/json": "^2.2.239",
    "@playwright/test": "^1.64.1",
    "@release-it/conventional-changelog": "10.0.1",
    "@solid-primitives/storage": "^4.3.3",
    "@solidjs/testing-library": "^0.8.10",
    "@types/babel__core": "7.20.5",
    "@types/bun": "1.4.3",
    "@types/node": "^24.6.2",
    "@types/webextension-polyfill": "^0.12.0",
    "@unocss/preset-rem-to-px": "^66.6.0",
    "@unocss/reset": "^66.5.2",
    "babel-preset-solid": "1.9.10",
    "chrome-types": "0.1.380",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "crx": "^5.0.1",
    "eslint-plugin-solid": "^0.14.5",
    "graphql": "16.11.0",
    "release-it": "19.0.5",
    "tailwind-merge": "3.3.1",
    "type-fest": "5.0.1",
    "typescript": "^5.9.2",
    "typescript-plugin-css-modules": "5.2.0",
    "unocss": "^66.5.2",
    "unocss-preset-animations": "1.2.1",
    "unocss-preset-primitives": "0.0.2-beta.2",
    "unplugin-auto-import": "^20.2.0",
    "unplugin-icons": "^22.4.2",
    "vite": "^7.1.9",
    "vite-plugin-solid": "^2.11.8",
    "web-ext": "^8.9.0",
    "webext-bridge": "^6.0.1",
    "webextension-polyfill": "^0.12.0"
  }
}
