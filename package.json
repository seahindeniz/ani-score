{
  "name": "ani-score-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.3",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "bun": ">=1.4"
  },
  "scripts": {
    "dev": "bun run --parallel --workspaces --if-present dev",
    "dev-firefox": "bun run --parallel --workspaces --if-present dev-firefox",
    "dev:site": "bun run --filter @ani-score/site dev",
    "build": "bun run --workspaces --if-present build",
    "build-firefox": "bun run --workspaces --if-present build-firefox",
    "build:site": "bun run --filter @ani-score/site build",
    "lint": "bun run --workspaces --if-present lint",
    "test": "bun run --workspaces --if-present test",
    "release": "bun run --workspaces --if-present release"
  },
  "devDependencies": {
    "@commitlint/cli": "20.1.0",
    "@commitlint/config-conventional": "20.0.0",
    "lefthook": "2.2.2"
  },
  "trustedDependencies": [
    "lefthook"
  ]
}
