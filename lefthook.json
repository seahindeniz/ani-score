{
  "$schema": "https://raw.githubusercontent.com/evilmartians/lefthook/master/schema.json",
  "assert_lefthook_installed": true,
  "pre-commit": {
    "jobs": [
      {
        "name": "format staged files",
        "run": "bun fmt --no-script --staged"
      },
      {
        "name": "lint staged files",
        "run": "bun lint --no-script --staged"
      }
    ]
  },
  "commit-msg": {
    "commands": {
      "lint commit message": {
        "run": "bunx --bun commitlint --edit {1}"
      }
    }
  },
  "pre-push": {
    "parallel": true,
    "commands": {
      "lint": {
        "run": "bun run lint"
      },
      "test": {
        "skip": true,
        "run": "bun run test"
      }
    }
  }
}
