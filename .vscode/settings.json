{
  "typescript.tsdk": "node_modules/typescript/lib",
  "vite.autoStart": false,
  // `bun fmt` has no editor integration yet, so the Run on Save extension runs it after each save
  "editor.formatOnSave": false,
  "emeraldwalk.runonsave": {
    "commands": [
      {
        "match": "\\.(?:[cm]?[jt]sx?|json|jsonc|ya?ml|toml|md|mdx|css|scss|html)$",
        "cmd": "bun fmt --no-script \"${file}\""
      }
    ]
  },
  "files.associations": {
    "*.css": "postcss"
  },
  "svg.preview.background": "custom",
  "typescript.preferences.quoteStyle": "single",
  "javascript.preferences.quoteStyle": "single"
}
